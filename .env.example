# ─────────────────────────────────────────────────────────────
#  wordpress-mcp · configuración
#  Copia este archivo a ".env" y rellena los valores.
#  NUNCA subas .env a git.
# ─────────────────────────────────────────────────────────────

# ── REST API ────────────────────────────────────────────────
# URL pública del sitio (sin barra final)
WP_URL=https://tudominio.com
# Usuario administrador de WordPress
WP_USERNAME=admin
# Application Password: wp-admin → Usuarios → Perfil → "Contraseñas de aplicación"
# (puedes pegarla con o sin espacios)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── SSH / SFTP / WP-CLI (opcional pero recomendado) ─────────
# Hostinger: hPanel → Avanzado → Acceso SSH. Puerto típico 65002.
SSH_HOST=
SSH_PORT=65002
SSH_USERNAME=
# Usa clave privada (recomendado) O contraseña.
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=
SSH_PASSWORD=
# Huella de la clave del servidor (protege contra man-in-the-middle).
# `npm run check` te muestra el valor la primera vez que conectas.
SSH_HOST_FINGERPRINT=
# Ruta absoluta a la instalación de WordPress en el servidor
# Hostinger: /home/uXXXXXXXXX/domains/tudominio.com/public_html
WP_ROOT=
# Binario de WP-CLI en el servidor
WP_CLI_BIN=wp

# ── Seguridad ───────────────────────────────────────────────
# true = ninguna herramienta puede modificar nada
READ_ONLY=false
# Rutas (relativas a WP_ROOT, separadas por coma) donde se permite ESCRIBIR archivos.
# Usa "*" para permitir toda la instalación (no recomendado).
WRITE_ALLOWED_PATHS=wp-content
# Carpetas locales desde las que se permite subir medios (separadas por ';'). Vacío = cualquiera.
# Recomendado: LOCAL_UPLOAD_DIRS=C:\Users\tu-usuario\Pictures;C:\Users\tu-usuario\Downloads
LOCAL_UPLOAD_DIRS=
# Solo para sitios locales sin HTTPS
ALLOW_INSECURE_HTTP=false
# Ocultar contraseñas y salts al leer wp-config.php / .env remotos
REDACT_SECRETS=true
# Carpeta local para copias de seguridad automáticas antes de cada escritura
BACKUP_DIR=./backups
# Timeout de peticiones (ms)
REQUEST_TIMEOUT_MS=30000
